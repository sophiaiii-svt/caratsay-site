# 克拉SAY 云端回忆册 —— Supabase 配置
# 用法：把本文件复制为 .env（同目录），填入下面的值后重新构建即可。
# 注意：VITE_ 开头的环境变量会被打包进前端（anon key 本就是公开密钥，可放心）。

# 你的 Supabase 项目地址（Project Settings → Data API → Project URL）
VITE_SUPABASE_URL=

# 你的 anon / public key（Project Settings → Data API → anon public）
VITE_SUPABASE_ANON_KEY=

# Storage 里的公开桶名称（建议就用 caratsay）
VITE_SUPABASE_BUCKET=caratsay

# ── 永久化媒体存储（Cloudflare R2，presign 跑在 Vercel 的 /api/presign Serverless Function）──
# 置为 true 时，上传的媒体走 R2（Vercel 函数签发预签名 → 浏览器直传），JSON 动态索引仍留 Supabase。
# VITE_ 前缀变量会注入前端；R2_ 前缀变量只在 Vercel 服务端函数使用，前端零密钥。
# 开启前需在 Vercel 项目 Settings → Environment Variables 配置 5 个 R2_ 服务端变量（见下）。
VITE_R2_ENABLED=false

# ── 以下 R2_ 变量仅在 Vercel 服务端 /api/presign 使用，不要加 VITE_ 前缀 ──
# Cloudflare 账户 ID（R2 概览页右上角）
R2_ACCOUNT_ID=
# R2 API Token 的 Access Key ID（R2 → Manage R2 API Tokens → Create API token → 复制）
R2_ACCESS_KEY_ID=
# R2 API Token 的 Secret（仅创建时显示一次）
R2_SECRET_ACCESS_KEY=
# 桶名（创建时填写，如 caratsay-media）
R2_BUCKET=
# 桶的公开访问地址（桶 Settings → Public access → Enable 后给出的 https://<bucket>.<account>.r2.dev）
R2_PUBLIC_URL=
