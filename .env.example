# 克拉SAY 云端回忆册 —— Supabase 配置
# 用法：把本文件复制为 .env（同目录），填入下面的值后重新构建即可。
# 注意：VITE_ 开头的环境变量会被打包进前端（anon key 本就是公开密钥，可放心）。

# 你的 Supabase 项目地址（Project Settings → Data API → Project URL）
VITE_SUPABASE_URL=

# 你的 anon / public key（Project Settings → Data API → anon public）
VITE_SUPABASE_ANON_KEY=

# Storage 里的公开桶名称（建议就用 caratsay）
VITE_SUPABASE_BUCKET=caratsay

# ── 永久化媒体存储（Cloudflare R2，presign 跑在已连好的 CloudBase 云函数 presign-r2）──
# 置为 true 时，上传的媒体走 R2（云函数签发预签名 → 浏览器直传），JSON 动态索引仍留 Supabase。
# 仅前端 Vite 构建时注入；R2 密钥只存在云端 presign-r2 函数的环境变量里，前端零密钥。
# 注意：开启前需先在 CloudBase 控制台给 presign-r2 函数配置 R2_ACCOUNT_ID / R2_ACCESS_KEY_ID /
#       R2_SECRET_ACCESS_KEY / R2_BUCKET / R2_PUBLIC_URL 五个环境变量。
VITE_R2_ENABLED=false
